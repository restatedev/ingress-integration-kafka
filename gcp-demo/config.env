# gcp-demo configuration — EDIT the REQUIRED block, the rest have sane defaults.
#
# Sourced by ./lib.sh (plain bash). Keep it valid bash: no spaces around '='.

# ============================ REQUIRED ============================
# Your GCP project id (not the number).
PROJECT_ID="doss-testing"

# Region for GKE + Managed Kafka (must be the same, they share the VPC subnet).
REGION="us-central1"

# Images the demo builds, pushes, and deploys. Leave BLANK to auto-derive them
# from PROJECT_ID/REGION/AR_REPO (recommended -- see the bottom of this file).
# ./build-images.sh builds & pushes both:
#   - RESTATE_IMAGE: Restate build with the ingestion gRPC API (restate.ingestion.v1),
#     built from ../restate.
#   - INGRESS_IMAGE: this repo's image + the GCP Kafka auth handler (Dockerfile.gcp).
# Set explicit refs here only to override the derived defaults.
RESTATE_IMAGE=""
INGRESS_IMAGE=""

# Restate source checkout to `docker build` into $RESTATE_IMAGE (built locally,
# then pushed by build-images.sh). Blank => the sibling ../restate of this repo.
RESTATE_SRC_DIR=""
RESTATE_DOCKERFILE="docker/Dockerfile"   # path to the Dockerfile within RESTATE_SRC_DIR

# ======================= USUALLY FINE AS-IS =======================
# Networking: the VPC subnet shared by GKE and Managed Kafka. The "default"
# auto-mode VPC has a "default" subnet in every region.
NETWORK="default"
SUBNET="default"

# Artifact Registry repo (Docker) for your images; created by build-images.sh / setup.sh.
AR_REPO="restate-demo"

# GKE (Autopilot: Workload Identity is on by default, no node pools to manage).
GKE_CLUSTER="restate-demo"

# Managed Service for Apache Kafka. Minimum is 3 vCPU / 3 GiB.
KAFKA_CLUSTER="restate-demo"
KAFKA_CPU="3"
KAFKA_MEMORY="3221225472"        # bytes = 3 GiB (gcloud wants bytes here)
# Two demo topics (partition/replication settings shared).
TOPIC_STATIC="counter-topic"     # -> static mapper -> Counter/add
TOPIC_DYNAMIC="map-topic"        # -> dynamic mapper -> MapObject/set (VO key from JSON)
TOPIC_PARTITIONS="3"
TOPIC_REPLICATION="3"

# Bootstrap address. Left blank => derived from the documented format:
#   bootstrap.<cluster>-<region>.managedkafka.<project>.cloud.goog:9092
# Override here if your cluster reports a different one (console -> cluster -> Configuration).
KAFKA_BOOTSTRAP=""

# Kubernetes-side names.
NAMESPACE="restate-demo"
KSA_NAME="kafka-ingress"          # Kubernetes ServiceAccount used by ingress + producer
GSA_NAME="restate-kafka-ingress"  # IAM service account it links to (Workload Identity)
GSA_EMAIL="${GSA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"

# The demo target: Java SDK test-services image, Counter virtual object.
TEST_SERVICES_IMAGE="ghcr.io/restatedev/test-services-java:main"
TEST_SERVICES="Counter,MapObject"   # both demo targets exposed by the image
# The ingress record-mapper targets are inlined in the manifests:
#   static  -> Counter/add   (k8s/40-ingress-static.yaml)
#   dynamic -> MapObject/set (k8s/45-ingress-dynamic.yaml)
RESTATE_STORAGE_SIZE="10Gi"

# GCP Kafka auth login handler (github.com/googleapis/managedkafka).
AUTH_HANDLER_VERSION="1.0.6"

# Helper images used by the build + one-off Jobs/pods. Java bits are all temurin 25
# (the jib runtime base in build.gradle.kts is eclipse-temurin:25-jre).
BASE_INGRESS_IMAGE="ghcr.io/restatedev/ingress-integration-kafka:latest"  # base for Dockerfile.gcp
MAVEN_IMAGE="maven:3-eclipse-temurin-25"
KAFKA_CLI_IMAGE="apache/kafka:3.9.0"
CURL_IMAGE="curlimages/curl:8.11.1"
CONTAINER_ENGINE="docker"         # docker or podman (build-images.sh)

# Demo data is inlined where it's used (so the manifests read literally):
#  - static:  key "user-1", values 1..5      -> k8s/50-producer-static.yaml,  Counter.get == 15
#  - dynamic: {"key":"alice","value":"hello"} + {"key":"bob","value":"world"}
#             -> k8s/55-producer-dynamic.yaml, VO key from /key -> MapObject.set

# --- derived: image refs default to your Artifact Registry when left blank above.
#     Format: REGION-docker.pkg.dev/PROJECT_ID/AR_REPO/<name>:demo
: "${RESTATE_IMAGE:=${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/restate:demo}"
: "${INGRESS_IMAGE:=${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/ingress-gcp:demo}"
